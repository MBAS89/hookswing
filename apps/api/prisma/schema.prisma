generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  githubId      String?   @unique @map("github_id")
  name          String?
  role          UserRole  @default(USER)
  plan          Plan      @default(FREE)
  stripeCustomerId String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  twoFactorSecret  String? @map("two_factor_secret")
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorBackupCodes String? @map("two_factor_backup_codes")
  emailVerified      Boolean   @default(false) @map("email_verified")
  emailVerificationToken String? @map("email_verification_token")
  emailVerificationExpires DateTime? @map("email_verification_expires")
  passwordResetToken String? @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  projects      Project[]
  teams         TeamMember[]
  teamsOwned    Team[]
  sentInvites   TeamInvite[] @relation("InvitedBy")
  sessions      Session[]
  comments            WebhookComment[]
  reactions           CommentReaction[]
  activityLogs        ActivityLog[]
  emailLogs           EmailLog[]
  notifications       Notification[]
  notificationPrefs   NotificationPreference[]
  feedback            Feedback[]
  supportChats        SupportChat[]

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
}

enum Plan {
  FREE
  PRO
  TEAM
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Team {
  id          String   @id @default(cuid())
  name        String
  ownerId     String   @map("owner_id")
  createdAt   DateTime @default(now()) @map("created_at")

  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invites     TeamInvite[]
  projects    Project[]
  activityLogs ActivityLog[]

  @@map("teams")
}

model TeamMember {
  id     String @id @default(cuid())
  teamId String @map("team_id")
  userId String @map("user_id")
  role   TeamRole @default(MEMBER)

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model TeamInvite {
  id          String   @id @default(cuid())
  teamId      String   @map("team_id")
  email       String
  role        TeamRole @default(MEMBER)
  status      InviteStatus @default(PENDING)
  token       String   @unique
  invitedById String   @map("invited_by_id")
  acceptedAt  DateTime? @map("accepted_at")
  declinedAt  DateTime? @map("declined_at")
  createdAt   DateTime @default(now()) @map("created_at")
  expiresAt   DateTime @map("expires_at")

  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedBy   User     @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([teamId, status])
  @@map("team_invites")
}

enum TeamRole {
  MEMBER
  ADMIN
}

model Notification {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  type      String
  title     String
  message   String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

model NotificationPreference {
  id      String @id @default(cuid())
  userId  String @map("user_id")
  type    String
  enabled Boolean @default(true)

  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
  @@map("notification_preferences")
}

model Project {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  customSlug  String?   @unique @map("custom_slug")
  description String?
  userId      String?   @map("user_id")
  teamId      String?   @map("team_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user        User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  team        Team?     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  webhooks    Webhook[]
  integrations Integration[]
  alertConfigs AlertConfig[]

  @@map("projects")
}

model AlertConfig {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  type      String   // 'slack' | 'discord' | 'telegram'
  url       String
  config    Json?    // type-specific extra data (e.g. telegram chatId)
  enabled   Boolean  @default(true) @map("enabled")
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("alert_configs")
}

model Webhook {
  id          String   @id @default(cuid())
  projectId   String?  @map("project_id")
  method      String
  headers     Json
  body        Json?
  rawBody     String?  @map("raw_body")
  query       Json?
  ip          String
  userAgent   String?  @map("user_agent")
  source      String?
  eventType   String?  @map("event_type")
  statusCode  Int?     @map("status_code")
  responseBody String? @map("response_body")
  responseTime Int?     @map("response_time_ms")
  isReplay    Boolean  @default(false) @map("is_replay")
  originalId  String?  @map("original_id")
  createdAt   DateTime @default(now()) @map("created_at")

  project     Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments    WebhookComment[]

  @@index([projectId, createdAt])
  @@map("webhooks")
}

model WebhookUsage {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  year      Int
  month     Int      // 0-11
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, year, month])
  @@map("webhook_usage")
}

model Integration {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  type      IntegrationType
  config    Json
  createdAt DateTime @default(now()) @map("created_at")

  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("integrations")
}

enum IntegrationType {
  SLACK
  DISCORD
  EMAIL
}

model ActivityLog {
  id         String   @id @default(cuid())
  teamId     String   @map("team_id")
  userId     String   @map("user_id")
  action     String   // e.g. 'project_created', 'webhook_replayed', 'member_invited'
  targetType String?  @map("target_type") // 'project', 'webhook', 'member', 'team'
  targetId   String?  @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  team       Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([teamId, createdAt])
  @@map("activity_logs")
}

model EmailLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  to        String
  subject   String
  type      String   // 'verification', 'password_reset', 'welcome'
  status    String   @default("pending") // 'pending', 'sent', 'failed', 'bounced'
  error     String?
  createdAt DateTime @default(now()) @map("created_at")

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type, createdAt])
  @@map("email_logs")
}

model WebhookComment {
  id        String   @id @default(cuid())
  webhookId String   @map("webhook_id")
  userId    String   @map("user_id")
  parentId  String?  @map("parent_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  webhook   Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent    WebhookComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   WebhookComment[] @relation("CommentReplies")
  reactions CommentReaction[]

  @@index([webhookId, createdAt])
  @@index([parentId])
  @@map("webhook_comments")
}

model CommentReaction {
  id        String   @id @default(cuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  type      String   // 'like' | 'dislike'
  createdAt DateTime @default(now()) @map("created_at")

  comment   WebhookComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@map("comment_reactions")
}

model StripeEvent {
  id        String   @id
  type      String
  processed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@map("stripe_events")
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  subject   String
  message   String
  status    String   @default("open") @map("status")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("feedback")
}

model SupportChat {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  message   String
  isAdmin   Boolean  @default(false) @map("is_admin")
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("support_chats")
}

model AdminAlertConfig {
  id        String   @id @default(cuid())
  type      String   // 'telegram'
  url       String
  config    Json?    // { chatId, botToken }
  enabled   Boolean  @default(true) @map("enabled")
  events    String[] // e.g. ['user_registered', 'subscription_created']
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("admin_alert_configs")
}
