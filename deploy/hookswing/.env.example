# ============================================
# HookSwing Production Environment
# Copy this to .env and fill in real values
# ============================================

# Database (used by docker-compose to set Postgres password)
POSTGRES_PASSWORD=change_this_to_a_strong_password

# API Server
PORT=3000

# Database & Cache
# These are auto-set in docker-compose.prod.yml, but you can override:
# DATABASE_URL=postgresql://hookswing:your_password@postgres:5432/hookswing?schema=public
# REDIS_URL=redis://redis:6379

# Security (generate strong random strings)
JWT_SECRET=your_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars
HOOKSWING_ENCRYPTION_KEY=your_encryption_key_min_32_chars

# Frontend URL (your domain)
FRONTEND_URL=https://hookswing.com

# Email (Resend)
RESEND_API_KEY=re_xxxxxxxx
FROM_EMAIL=notifications@yourdomain.com
FROM_NAME=HookSwing

# Stripe (optional — remove if not using billing)
STRIPE_SECRET_KEY=sk_live_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxx
STRIPE_PRICE_PRO_YEARLY=price_xxxxxxxx
STRIPE_PRICE_TEAM=price_xxxxxxxx
STRIPE_PRICE_TEAM_YEARLY=price_xxxxxxxx

# OAuth (optional — remove if not using social login)
GITHUB_CLIENT_ID=your_github_app_id
GITHUB_CLIENT_SECRET=your_github_app_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Node environment
NODE_ENV=production
